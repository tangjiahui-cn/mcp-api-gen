{
  "name": "mcp-api-gen",
  "version": "0.3.3",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "description": "A MCP for api auto-generation from OpenAPI 2/3 (private network). Takes ~1s for 1000+ APIs.reproducible results, custom request examples. For Trae, Cursor, etc.",
  "scripts": {
    "dev": "cross-env mode=development tsx build.ts --watch",
    "build": "cross-env mode=production tsx build.ts && shx chmod +x dist/index.js",
    "build:full": "cross-env mode=development tsx build.ts && shx chmod +x dist/index.js",
    "debug": "tsx watch debug.ts",
    "debug:mcp": "npx @modelcontextprotocol/inspector node ./dist/index.js",
    "docs:playground": "pnpm -F playground docs:playground"
  },
  "bin": {
    "mcp-api-gen": "./dist/index.js"
  },
  "author": "tangjiahui-cn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangjiahui-cn/mcp-api-gen.git"
  },
  "bugs": {
    "url": "https://github.com/tangjiahui-cn/mcp-api-gen/issues"
  },
  "homepage": "https://github.com/tangjiahui-cn/mcp-api-gen#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "openapi",
    "swagger",
    "mcp",
    "mcp-server",
    "api-generator",
    "frontend",
    "typescript",
    "automation",
    "ai",
    "ai-editor",
    "cursor",
    "trae"
  ],
  "dependencies": {
    "@babel/generator": "7",
    "@babel/parser": "7",
    "@babel/traverse": "7",
    "@babel/types": "7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "prettier": "^3.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.19.39",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "shx": "^0.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
